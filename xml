     "MyButtonListener",
     "ComponentLClickUp",
     function(context)
         return child_uic == UIComponent(context.component)
     end,
     function(context)
         out("It Worked!")
     end,
     true
 )&lt;/code&gt;
Every time the button is pressed, I would find a new line in my script log saying “It Worked!”. How quaint.

